<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <!-- Liquid Glass Header + Search (Apple Messages) -->
    <LinearLayout
        android:id="@+id/headerGlass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_glass"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Messages"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/header_sender"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/settingsGear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_glass"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@animator/tactile_button"
                android:text="⚙"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Apple pill search -->
        <LinearLayout
            android:id="@+id/searchPill"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_pill"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textColor="@color/search_icon"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/search_hint"
                android:textSize="15sp" />

            <Button
                android:id="@+id/searchClear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_btn_glass"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main content area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <!-- Chats list -->
        <ListView
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@android:color/transparent"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <ListView
            android:id="@+id/contactList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:listSelector="@android:color/transparent"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <!-- Calls page: recents + iPhone dialer -->
        <LinearLayout
            android:id="@+id/callsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ListView
                android:id="@+id/callList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:listSelector="@android:color/transparent"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:scrollbars="none" />

            <!-- iPhone dialer will be dialPad below, kept visible inside callsPage when that tab active -->
        </LinearLayout>

        <!-- Thread (conversation) — Apple bubble style -->
        <LinearLayout
            android:id="@+id/threadPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_glass"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <Button
                    android:id="@+id/threadBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_glass"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@animator/tactile_button"
                    android:text="‹"
                    android:textColor="@color/primary"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/threadTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/threadSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/threadCall"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_primary"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@animator/tactile_button"
                    android:text="📞"
                    android:textColor="@color/on_accent"
                    android:textSize="16sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/threadList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="6dp"
                android:listSelector="@android:color/transparent"
                android:paddingTop="2dp"
                android:paddingBottom="80dp"
                android:scrollbars="none"
                android:transcriptMode="alwaysScroll" />
        </LinearLayout>

        <!-- Settings (new) -->
        <ScrollView
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Connection -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="CONNECTION"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.06" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <RadioGroup
                        android:id="@+id/roleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_seg"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <RadioButton
                            android:id="@+id/roleSender"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab"
                            android:button="@null"
                            android:gravity="center"
                            android:minWidth="0dp"
                            android:stateListAnimator="@animator/tactile_button"
                            android:text="@string/role_sender_short"
                            android:textColor="@color/tab_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/roleReceiver"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginLeft="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab"
                            android:button="@null"
                            android:gravity="center"
                            android:minWidth="0dp"
                            android:stateListAnimator="@animator/tactile_button"
                            android:text="@string/role_receiver_short"
                            android:textColor="@color/tab_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RadioGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/peerSpinner"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:minHeight="44dp" />

                        <Button
                            android:id="@+id/refreshButton"
                            android:layout_width="44dp"
                            android:layout_height="40dp"
                            android:layout_marginLeft="6dp"
                            android:background="@drawable/bg_btn_glass"
                            android:minWidth="0dp"
                            android:stateListAnimator="@animator/tactile_button"
                            android:text="@string/refresh_short"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/status"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/startButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_primary"
                            android:minHeight="44dp"
                            android:stateListAnimator="@animator/tactile_button"
                            android:text="@string/start"
                            android:textColor="@color/on_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/stopButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginLeft="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_glass"
                            android:minHeight="44dp"
                            android:stateListAnimator="@animator/tactile_button"
                            android:text="@string/stop"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/simulateButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_glass"
                        android:minHeight="44dp"
                        android:stateListAnimator="@animator/tactile_button"
                        android:text="@string/simulate_short"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="6dp"
                    android:text="APPEARANCE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.06" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Theme follows system • Liquid Glass 20px / 60%"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Blur is applied to header, tab bar and composer. Falls back to translucent on slower GPUs."
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="6dp"
                    android:text="ABOUT"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.06" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SMSBridge — Messages over Bluetooth"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Turn a spare phone into a second phone. No internet, no servers."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/aboutVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="v0.3.0"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Floating pill composer (Apple) — glass + blur -->
    <LinearLayout
        android:id="@+id/composerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <!-- To field (Apple new-message style, hidden in thread) -->
        <EditText
            android:id="@+id/smsToNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_pill"
            android:hint="@string/sms_to_hint"
            android:inputType="phone"
            android:minHeight="44dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/search_hint"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/composerPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_composer_pill"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <EditText
                android:id="@+id/smsBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/sms_body_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="36dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/search_hint"
                android:textSize="15sp" />

            <Button
                android:id="@+id/smsSend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_primary"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:stateListAnimator="@animator/tactile_button"
                android:text="↑"
                android:textColor="@color/on_accent"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- iPhone dialer (shown only on Calls tab) -->
    <LinearLayout
        android:id="@+id/dialPad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/callNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_pill"
            android:gravity="center"
            android:hint="@string/call_dialer_hint"
            android:inputType="phone"
            android:minHeight="48dp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/search_hint"
            android:textSize="22sp"
            android:letterSpacing="0.04" />

        <!-- Simple 3-button row for now + dialer grid could be added later -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/callDialButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:singleLine="true"
                android:stateListAnimator="@animator/tactile_button"
                android:text="@string/call_dial"
                android:textColor="@color/on_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/callAnswerButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_answer"
                android:singleLine="true"
                android:stateListAnimator="@animator/tactile_button"
                android:text="@string/call_answer"
                android:textColor="@color/on_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/callRejectButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_reject"
                android:singleLine="true"
                android:stateListAnimator="@animator/tactile_button"
                android:text="@string/call_reject"
                android:textColor="@color/on_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/callDialerButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_glass"
            android:minHeight="36dp"
            android:stateListAnimator="@animator/tactile_button"
            android:text="@string/call_set_dialer"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Liquid Glass Tab Bar — 4 tabs -->
    <LinearLayout
        android:id="@+id/bottomTabBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_tab_bar_glass"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <RadioGroup
            android:id="@+id/tabGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:minWidth="0dp"
                android:stateListAnimator="@animator/tactile_button"
                android:text="@string/tab_chats"
                android:textColor="@color/tab_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/tabContacts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:stateListAnimator="@animator/tactile_button"
                android:text="@string/tab_contacts"
                android:textColor="@color/tab_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/tabCall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:stateListAnimator="@animator/tactile_button"
                android:text="@string/tab_calls"
                android:textColor="@color/tab_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/tabSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:button="@null"
                android:gravity="center"
                android:minWidth="0dp"
                android:stateListAnimator="@animator/tactile_button"
                android:text="Settings"
                android:textColor="@color/tab_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RadioGroup>
    </LinearLayout>

</LinearLayout>
