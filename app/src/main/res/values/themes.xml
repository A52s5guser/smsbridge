<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorError">@color/err</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <!-- Subtle blur of whatever sits behind the window (wallpaper, dialogs) -->
        <item name="android:windowBackgroundBlurRadius">24dp</item>
        <item name="android:windowBlurBehindRadius">24dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorControlHighlight">@color/ripple_color</item>
    </style>

    <!-- AMOLED monochrome: pure black surfaces, white elements, no color -->
    <style name="AppTheme.Mono" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#262626</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="colorSecondary">#BDBDBD</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSecondaryContainer">#1F1F1F</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorTertiary">#9E9E9E</item>
        <item name="colorOnTertiary">#000000</item>
        <item name="colorTertiaryContainer">#242424</item>
        <item name="colorOnTertiaryContainer">#FFFFFF</item>
        <item name="colorError">#E0E0E0</item>
        <item name="colorOnError">#000000</item>
        <item name="colorErrorContainer">#2A2A2A</item>
        <item name="colorOnErrorContainer">#FFFFFF</item>
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#B3B3B3</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#111111</item>
        <item name="colorSurfaceContainerHigh">#1A1A1A</item>
        <item name="colorSurfaceContainerHighest">#242424</item>
        <item name="colorOutline">#8A8A8A</item>
        <item name="colorOutlineVariant">#2E2E2E</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowBackgroundBlurRadius">24dp</item>
        <item name="android:windowBlurBehindRadius">24dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
