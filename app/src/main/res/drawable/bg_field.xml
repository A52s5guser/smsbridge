<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/glass_bottom"
                android:startColor="@color/glass_top" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/rimlight" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <inset android:insetBottom="60%">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="90"
                    android:startColor="@color/glass_sheen"
                    android:endColor="@android:color/transparent" />
                <corners android:topLeftRadius="14dp" android:topRightRadius="14dp" />
            </shape>
        </inset>
    </item>
</layer-list>
