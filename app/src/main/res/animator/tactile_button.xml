<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.97" android:duration="90" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.97" android:duration="90" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationZ" android:valueTo="1dp" android:duration="90"/>
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="120" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="120" android:interpolator="@android:interpolator/fast_out_slow_in"/>
            <objectAnimator android:propertyName="translationZ" android:valueTo="3dp" android:duration="120"/>
        </set>
    </item>
</selector>
